# Coinbase CLI Authentication
# JWT/ES256 keys mounted from ~/.coinbase/cdp_api_key.json

COINBASE_ENV=live
COINBASE_API_KEY_ID=your-api-key-id
COINBASE_PRIVATE_KEY_PEM=$(cat /root/.coinbase/cdp_api_key.json | jq -r '.privateKey')
COINBASE_PROJECT_ID=your-project-id

# Trading mode
TRADING_MODE=paper
LIVE_TRADING_ENABLED=true
PAPER_TRADING=true

# Coinbase CLI path
COINBASE_CLI_PATH=/usr/local/bin/coinbase
