# Copy to a host-managed file outside source control and replace every secret.
# Start with: docker compose --env-file /secure/path/portfolio.env -f docker-compose.production.yml up -d --build

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_runtime
POSTGRES_PASSWORD=replace-with-a-long-random-password

OPERATOR_ADMIN_TOKEN=replace-with-a-long-random-admin-token
OPERATOR_CSRF_TOKEN=replace-with-a-separate-random-csrf-token
CORS_ORIGINS=https://portfolio.example.internal

# Bind the API to localhost and place TLS/authentication in a host reverse proxy.
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000

# Local inference is the production-paper default. Set false only for a deliberately remote-only deployment.
LOCAL_LLM_EXECUTION_REQUIRED=true

# Preferred fleet configuration. Keep this JSON on one line in the actual env file.
# Every endpoint must expose OpenAI-compatible GET /v1/models and POST /v1/chat/completions.
# Replace model IDs with the exact identifiers returned by each node's /v1/models endpoint.
LOCAL_LLM_NODES_JSON=[{"id":"x1-370","name":"x1-370","kind":"lmstudio","baseUrl":"http://x1-370.lan:1234/v1","models":["replace-with-loaded-heavy-model-id"],"priority":30,"maxConcurrent":1,"prefillTokensPerSecond":100,"decodeTokensPerSecond":25,"estimatedWatts":110,"contextLength":65536,"tags":["primary","heavy-reasoning"]},{"id":"xwing","name":"xwing","kind":"llama.cpp","baseUrl":"http://xwing.lan:8080/v1","models":["replace-with-loaded-heavy-model-id"],"priority":20,"maxConcurrent":1,"prefillTokensPerSecond":90,"decodeTokensPerSecond":22,"estimatedWatts":125,"contextLength":65536,"tags":["secondary","heavy-reasoning"]},{"id":"macbook-air","name":"macbook-air","kind":"lmstudio","baseUrl":"http://macbook-air.lan:1234/v1","models":["replace-with-fast-small-model-id"],"priority":15,"maxConcurrent":2,"prefillTokensPerSecond":140,"decodeTokensPerSecond":45,"estimatedWatts":35,"contextLength":32768,"tags":["fast-scout","summarization"]}]

# Simpler fallback when all nodes can be treated with the same default measurements.
# LOCAL_LLM_ENDPOINTS=http://x1-370.lan:1234/v1,http://xwing.lan:8080/v1,http://macbook-air.lan:1234/v1
LOCAL_LLM_ENDPOINTS=
LOCAL_LLM_API_KEY=

# Used only when a node omits an explicit value above. Replace with measured benchmarks.
LOCAL_LLM_DEFAULT_PREFILL_TPS=80
LOCAL_LLM_DEFAULT_DECODE_TPS=20
LOCAL_LLM_DEFAULT_WATTS=110
LOCAL_LLM_DEFAULT_CONTEXT_LENGTH=32768
LOCAL_LLM_ELECTRICITY_RATE_PER_KWH=0.14
LOCAL_LLM_HARDWARE_DEPRECIATION_PER_HOUR=0.18

# A process killed during inference cannot leave a quote permanently running.
# Local stale calls fail closed and require a new node quote before retry.
MODEL_CALL_STALE_SECONDS=300

# OpenRouter remains disabled until BOTH the enable flag and key are supplied here.
# The UI can then choose local-only, economic auto-selection, or OpenRouter-eligible policy,
# but it cannot reveal the key or override this deployment-level kill switch.
REMOTE_LLM_EXECUTION_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Portfolio OS

# Coinbase credentials are optional while COINBASE_DRY_RUN=true.
COINBASE_API_KEY=
COINBASE_API_SECRET=

ECONOMIC_MAINTENANCE_INTERVAL_MS=60000
ECONOMIC_JOB_LEASE_SECONDS=300
ECONOMIC_JOB_RETRY_SECONDS=60
ECONOMIC_JOB_MAX_ATTEMPTS=5
ECONOMIC_WORKER_ID=economic-worker-1
ECONOMIC_SHUTDOWN_GRACE_MS=30000

# Control-plane sizing defaults for a 64 GB host.
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_WORK_MEM=16MB
POSTGRES_SLOW_QUERY_MS=500
API_MEMORY_LIMIT=4g
API_CPU_LIMIT=4
WORKER_MEMORY_LIMIT=6g
WORKER_CPU_LIMIT=6

# Optional logical backup profile.
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=14
