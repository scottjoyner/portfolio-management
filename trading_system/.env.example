# Trading System — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to version control.

# --- General ---
APP_ENV=dev
TRADING_MODE=PAPER
LOW_LATENCY_MODE=false

# --- Database ---
DATABASE_URL=postgresql+psycopg://trader:trader@postgres:5432/trading

# --- Redis (caching, rate limiting, pub/sub) ---
REDIS_URL=redis://redis:6379/0

# --- Coinbase Advanced Trade API ---
COINBASE_API_KEY=replace_me
COINBASE_API_SECRET=replace_me
COINBASE_PASSPHRASE=replace_me
COINBASE_PORTFOLIO_IDS=default

# --- Onchain RPC ---
# Get these from your RPC provider (Infura, Alchemy, etc.)
ETHEREUM_RPC_URL=
BASE_RPC_URL=

# --- Wallet ---
# Private key for the server wallet. Use an HSM or vault in production.
# NEVER use a key that holds real funds during development.
EVM_PRIVATE_KEY=

# --- Risk & Approvals ---
REQUIRE_APPROVALS=true
LIVE_TRADING_ENABLED=false

# --- GPU / Queue ---
GPU_ENABLED=false
QUEUE_MODEL=simple

# --- Canary ---
CANARY_ROLLOUT_PCT=0
