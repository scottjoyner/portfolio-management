[Unit]
Description=Portfolio Management Trading System API
After=network.target
Requires=network.target

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/opt/portfolio-management/trading_system
EnvironmentFile=/opt/portfolio-management/trading_system/deploy/.env
ExecStart=/opt/portfolio-management/trading_system/.venv/bin/uvicorn apps.api.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=on-failure
RestartSec=5s
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
