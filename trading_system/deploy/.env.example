# Environment configuration for trading_system
# Copy this file to deploy/.env and update secure values.

APP_ENV=production
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
REQUIRE_APPROVALS=true
QUEUE_MODEL=simple
CANARY_ROLLOUT_PCT=0

DATABASE_URL=postgresql://trader:trader@postgres:5432/trading
REDIS_URL=redis://redis:6379/0

COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=
COINBASE_PORTFOLIO_IDS=default

ETHEREUM_RPC_URL=
BASE_RPC_URL=
EVM_PRIVATE_KEY=
