.venv/
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
ENV/
env/

# IDE
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
.hints

