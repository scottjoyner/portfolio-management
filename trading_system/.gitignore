.env
.env.*
!.env.example
local_settings.py
settings.local.py

# Build artifacts
build/
dist/
*.egg-info/
*.egg

# Database files (if using SQLite for local dev)
*.db
*.sqlite
*.sqlite3
trading_system.db

# IDE project
.project
.settings/
.classpath

# Logs
logs/
*.log

# Test coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Jupyter notebooks outputs
.ipynb_checkpoints
outputs/

# Alembic migrations (if you want to track them, see docs/MIGRATION_GUIDE.md)
