# Temporary files
*.tmp
*.bak
temp/

# Docker volumes data (not the Dockerfile itself)
.docker/data/
postgres/*.db

# Generated test artifacts
tests/test_output/
artifacts/demo_*  # Move to docs/evidence or tests/fixtures/
tests/integration/test_data/
tests/sim/results/

# Large JSON dumps
*.json.gz
data/raw/

# Pycache in source directories
onchain/*/__pycache__/
apps/*/__pycache__/
storage/*/__pycache__/
