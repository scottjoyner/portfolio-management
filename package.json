{
  "name": "prediction-arb-system",
  "private": true,
  "version": "0.5.0-production-hardening",
  "packageManager": "pnpm@9.12.3",
  "type": "module",
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/**/*.test.mjs tests/integration/*.test.mjs",
    "test:integration:postgres": "node tests/integration/postgres-smoke.test.mjs",
    "build": "node scripts/build.mjs && node scripts/build-web.mjs && node scripts/validate-migrations.mjs && node scripts/validate-api-contract.mjs && node scripts/validate-security.mjs && node scripts/migrate-postgres.mjs --dry-run > /dev/null",
    "cli": "node apps/cli/src/index.mjs",
    "api": "node apps/api/src/server.p1.mjs",
    "web": "node apps/api/src/server.p1.mjs",
    "migrations:validate": "node scripts/validate-migrations.mjs",
    "migrations:dry-run": "node scripts/migrate-postgres.mjs --dry-run",
    "migrations:up": "node scripts/migrate-postgres.mjs",
    "api:validate": "node scripts/validate-api-contract.mjs",
    "security:validate": "node scripts/validate-security.mjs",
    "runtime:validate": "node scripts/validate-runtime-env.mjs",
    "certify:mock": "node scripts/certify-mock.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
