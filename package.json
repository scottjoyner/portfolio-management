{
  "name": "prediction-arb-system",
  "private": true,
  "version": "0.6.0-economic-local-runtime",
  "packageManager": "pnpm@9.12.3",
  "type": "module",
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/**/*.test.mjs tests/integration/*.test.mjs",
    "test:integration:postgres": "node tests/integration/postgres-smoke.test.mjs",
    "runtime-artifacts:validate": "node scripts/validate-runtime-artifacts.mjs",
    "build": "node scripts/typecheck.mjs && node scripts/validate-runtime-artifacts.mjs && node scripts/build.mjs && node scripts/build-web.mjs && node scripts/validate-migrations.mjs && node scripts/validate-api-contract.mjs && node scripts/validate-security.mjs && node scripts/validate-deployment.mjs && node scripts/validate-first-prod-release.mjs && node scripts/migrate-postgres.mjs --dry-run > /dev/null",
    "cli": "node apps/cli/src/index.mjs",
    "api": "node apps/api/src/server.p1.mjs",
    "web": "node apps/api/src/server.p1.mjs",
    "economics:once": "node scripts/run-economic-maintenance.mjs --once",
    "economics:worker": "node scripts/run-economic-maintenance.mjs",
    "migrations:validate": "node scripts/validate-migrations.mjs",
    "migrations:dry-run": "node scripts/migrate-postgres.mjs --dry-run",
    "migrations:up": "node scripts/migrate-postgres.mjs",
    "api:validate": "node scripts/validate-api-contract.mjs",
    "security:validate": "node scripts/validate-security.mjs",
    "runtime:validate": "node scripts/validate-runtime-env.mjs",
    "deploy:validate": "node scripts/validate-deployment.mjs",
    "first-prod:validate": "node scripts/validate-first-prod-release.mjs",
    "audit:verify": "node scripts/verify-audit-chain.mjs",
    "smoke:production-paper": "node scripts/smoke-production-paper.mjs",
    "certify:mock": "node scripts/certify-mock.mjs",
    "certify:production-paper": "node scripts/certify-production-paper.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
