[Unit]
Description=Portfolio Management Trading System (paper mode)
After=network-online.target
Wants=network-online.target
# Co-start the Hermes agent exit-watcher so agent paper positions are always
# guarded by the high-frequency stop-loss loop after a reboot.
Wants=portfolio-agent-watcher.service
After=portfolio-agent-watcher.service

[Service]
Type=simple
User=scott
Group=scott
WorkingDirectory=/home/scott/git/portfolio-management
Environment=HOME=/home/scott
Environment=PATH=/home/scott/.npm-global/bin:/home/scott/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/scott/git/portfolio-management/.venv/bin/python3 /home/scott/git/portfolio-management/run_production.py start
ExecStop=/home/scott/git/portfolio-management/.venv/bin/python3 /home/scott/git/portfolio-management/run_production.py stop
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
