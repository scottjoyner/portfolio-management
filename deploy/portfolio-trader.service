[Unit]
Description=Portfolio Management Trading System (paper mode)
After=network-online.target
Wants=network-online.target
# The Hermes agent exit-only watcher (portfolio-agent-watcher.service) is now a
# managed child of the supervisor (run_production.py), so it co-starts/restarts
# with this unit automatically. No separate Wants/After needed here.

[Service]
Type=simple
User=scott
Group=scott
WorkingDirectory=/home/scott/git/portfolio-management
Environment=HOME=/home/scott
Environment=PATH=/home/scott/.npm-global/bin:/home/scott/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/scott/git/portfolio-management/.venv/bin/python3 /home/scott/git/portfolio-management/run_production.py start
ExecStop=/home/scott/git/portfolio-management/.venv/bin/python3 /home/scott/git/portfolio-management/run_production.py stop
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
