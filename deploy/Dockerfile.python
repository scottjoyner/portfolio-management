# Shared Python service runtime (rebuilt from current code).
# Copies root entrypoints + root modules + rust_core + full venv lockfile.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Copy deploy/ first so the root requirements.txt `-r deploy/requirements.txt` resolves
COPY deploy/ /app/deploy/
COPY requirements.venv-lock.txt /app/requirements.lock.txt
RUN pip install --no-cache-dir -r /app/requirements.lock.txt

# Real source trees
COPY trading_system/ /app/trading_system/
COPY coinbase/ /app/coinbase/
COPY config.yaml /app/
# Root-level modules needed by the services + trader
COPY strategy_engine.py confidence_matrix.py state_store.py market_universe.py neo4j_store.py notification.py portfolio_optimizer.py approval_server.py /app/
# Archived-but-live entrypoints (alerts/data_collector live only in archive/root)
COPY archive/root/alerts.py /app/alerts.py
COPY archive/root/data_collector.py /app/data_collector.py
# Prebuilt Rust extension (strategy_engine imports rust_core)
COPY rust_core/ /app/rust_core/

ENV PYTHONPATH=/app:/app/trading_system:/app/coinbase

RUN mkdir -p /app/logs /app/data /app/state /app/templates
