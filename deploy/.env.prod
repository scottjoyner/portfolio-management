# Production Environment Variables - Trading System
## Machine: destroyer (ThinkPad T14 i7 32GB RAM)
## Date: 2026-05-27

# ============================================================================
# RPC ENDPOINTS - REPLACE WITH YOUR PRODUCTION KEYS
# ============================================================================

# Main Ethereum Mainnet
RPC_URL_ETH="https://eth-mainnet.g.alchemy.com/v2/YOUR_RPC_KEY"

# Arbitrum One
RPC_URL_ARBITRUM="https://arb-mainnet.g.alchemy.com/v2/YOUR_ARBITRUM_KEY"

# Optimism Mainnet  
RPC_URL_OPTIMISM="https://opt-mainnet.g.alchemy.com/v2/YOUR_OPTIMISM_KEY"

# Base Mainnet
RPC_URL_BASE="https://mainnet.base.org"

# Polygon PoS
RPC_URL_POLYGON="https://polygon-mainnet.g.alchemy.com/v2/YOUR_POLYGON_KEY"

# Avalanche C-Chain
RPC_URL_AVALANCHE="https://avax-mainnet.g.alchemy.com/v2/YOUR_AVALANCHE_KEY"

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

# Token metadata cache TTL (seconds) - Default: 1 hour
METADATA_CACHE_TTL=3600

# Event queue capacity - Default: 10k events
EVENT_QUEUE_CAPACITY=10000

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level - DEBUG|INFO|WARNING|ERROR - Default: INFO
LOG_LEVEL=INFO

# Log directory
LOG_DIR=/home/destroyer/trading_system/logs

# ============================================================================
# PERFORMANCE TUNING (Destroyer-Specific)
# ============================================================================

# Memory limit per container (2G for production on 32GB RAM)
MEMORY_LIMIT="4G"

# CPU cores per container (allocated from total available)
CPU_CORES=8

# Container restart policy - Default: unless-stopped (production)
RESTART_POLICY="unless-stopped"

# ============================================================================
# HEALTH CHECK CONFIGURATION
# ============================================================================

# Health check interval (seconds) - Default: 30s
HEALTH_CHECK_INTERVAL=30

# Health check timeout (seconds) - Default: 10s  
HEALTH_CHECK_TIMEOUT=10

# Health check retries before marking unhealthy - Default: 3
HEALTH_CHECK_RETRIES=3

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL database name
DATABASE_NAME="trading_system"

# PostgreSQL username (set in docker-compose)
DATABASE_USER="appuser"

# PostgreSQL password (use secrets management in production!)
# WARNING: Never commit actual passwords to git!
DATABASE_PASSWORD="${DATABASE_PASSWORD:-CHANGE_ME_IN_PRODUCTION}"

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable token metadata fetching (true/false)
ENABLE_METADATA_FETCHING=true

# Enable event listener (true/false)  
ENABLE_EVENT_LISTENER=true

# Enable pool polling (true/false)
ENABLE_POOL_POLLING=true

# Enable safety scoring engine (true/false)
ENABLE_SAFETY_SCORING=true

# ============================================================================
# RATE LIMITING & BACKOFF
# ============================================================================

# Default rate limit for RPC calls (requests per second)
RPC_RATE_LIMIT=5

# Exponential backoff max retries - Default: 3
MAX_RETRY_ATTEMPTS=3

# Backoff delay between retries (seconds) - Default: 2s
BACKOFF_DELAY_SECONDS=2

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Enable security headers in API responses
ENABLE_SECURITY_HEADERS=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS="${CORS_ORIGINS:-https://destroyer.internal.tailscale.net}"

# ============================================================================
# MONITORING & ALERTING
# ============================================================================

# Prometheus metrics endpoint port (default: 8000, same as API)
METRICS_PORT=8000

# Enable Prometheus metrics export (true/false)
ENABLE_PROMETHEUS_METRICS=true

# Alert email for production issues
ALERT_EMAIL="${ALERT_EMAIL:-alerts@falcon.internal}"

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Backup retention period (days) - Default: 30 days
BACKUP_RETENTION_DAYS=30

# Backup frequency (hourly/daily/weekly) - Default: daily  
BACKUP_FREQUENCY=daily

# Backup storage location
BACKUP_STORAGE_PATH=/home/destroyer/trading_system/data/backups
