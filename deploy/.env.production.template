# ============================================================================
# COINGECKO API KEY (Optional, for token metadata)
# Get free key from: https://www.coingecko.com/en/api/pricing
# ============================================================================

COINGECKO_API_KEY=""  # Optional - leave empty to use fallback ERC20 ABI method

# ============================================================================
# DATABASE CREDENTIALS
# WARNING: Store production database password separately! Never commit to git!
# Create .env.production with actual credentials before deployment.
# ============================================================================

DATABASE_PASSWORD=""  # ←←← ADD ACTUAL PASSWORD BEFORE DEPLOYMENT

# ============================================================================
# PERFORMANCE SETTINGS (Destroyer-Specific)
# Adjust based on available resources (32GB RAM, i7 CPU)
# ============================================================================

# Memory per container (default: 4G, max: ~16G for production on 32GB machine)
MEMORY_LIMIT="4G"

# CPU cores per container (default: 8, adjust based on available cores)
CPU_CORES=8

# Event queue capacity (default: 50000 events, increase if processing high throughput)
EVENT_QUEUE_CAPACITY=50000

# Token metadata cache TTL in seconds (default: 3600 = 1 hour)
METADATA_CACHE_TTL=3600

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Enable security headers
ENABLE_SECURITY_HEADERS=true

# CORS allowed origins (for API access from web UI, if applicable)
CORS_ORIGINS="https://destroyer.internal.tailscale.net"  # Internal Tailscale domain only

# Rate limiting per RPC endpoint (requests per second)
RPC_RATE_LIMIT=5

# Maximum retry attempts with exponential backoff
MAX_RETRY_ATTEMPTS=3

# Backoff delay between retries (seconds)
BACKOFF_DELAY_SECONDS=2

# ============================================================================
# MONITORING & ALERTING
# ============================================================================

# Prometheus metrics port (default: 8000, same as API port)
METRICS_PORT=8000

# Alert email for critical issues (production monitoring setup)
ALERT_EMAIL=""  # Add production monitoring alerting here when configured

# Slack webhook URL (for team notifications on issues)
SLACK_WEBHOOK_URL=""  # Optional - add after incident response workflow is set up

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Database backup retention (days, default: 30)
BACKUP_RETENTION_DAYS=30

# Backup storage path
BACKUP_STORAGE_PATH="/home/destroyer/trading_system/data/backups"

# Cron job for automatic daily backups at 2AM UTC
BACKUP_CRON="0 2 * * *"

# ============================================================================
# USAGE INSTRUCTIONS
# ============================================================================

# Step 1: Copy this file to working directory (if .env doesn't exist)
cp .env.production.template deploy/.env

# Step 2: Edit with ACTUAL RPC keys and DATABASE password
nano deploy/.env

# Step 3: Copy to trading_system directory
cp deploy/.env .env

# Step 4: Build and deploy!
cd /home/destroyer/trading_system
docker-compose -f deploy/docker-compose.prod.yml up -d --build

# ============================================================================
# SECURITY REMINDERS ⚠️
# ============================================================================

# NEVER commit actual RPC keys to public git repositories
