# Production Dockerfile - Trading System Runtime Service
# Build context: repo root (portfolio-management/)
# NOTE: Docker Compose is the canonical deploy path.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install dependencies from the canonical requirements file
COPY deploy/requirements.txt /app/deploy/requirements.txt
RUN pip install --no-cache-dir -r /app/deploy/requirements.txt

# Copy real source trees that exist in the repo
COPY trading_system/ /app/trading_system/
COPY coinbase/ /app/coinbase/
COPY config.yaml /app/

# Make trading_system importable (onchain.* lives here)
ENV PYTHONPATH=/app/trading_system:/app/coinbase

RUN mkdir -p /app/logs /app/data

# Non-root user for security
RUN useradd -u 1000 -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app

USER appuser

WORKDIR /app/trading_system

# Real HTTP healthcheck against the onchain poller health server
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:9090/ping'); sys.exit(0)" || exit 1

# Default command: run the onchain poller service
CMD ["python3", "-u", "-m", "onchain.pollers.service"]
