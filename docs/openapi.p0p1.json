{
  "openapi": "3.1.0",
  "info": {
    "title": "Portfolio Management Operator API",
    "version": "0.6.0-economic-local-runtime",
    "description": "Paper/guarded operator API with durable economic decisions, local-first intelligence routing, actual-cost reconciliation, opportunity review, execution lineage, and production-paper readiness. Live trading is not certified and remains blocked."
  },
  "servers": [
    { "url": "http://localhost:3000" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "Ok": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "requestId": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/health": { "get": { "summary": "Service health", "responses": { "200": { "description": "Healthy" }, "503": { "description": "Unavailable" } } } },
    "/ready": { "get": { "summary": "Fail-closed live readiness", "responses": { "503": { "description": "Not live-production ready" } } } },
    "/ready/production-paper": { "get": { "summary": "Paper-production readiness gate", "responses": { "200": { "description": "Paper-production ready" }, "503": { "description": "Paper-production blockers remain" } } } },
    "/metrics": { "get": { "summary": "JSON operational counters", "responses": { "200": { "description": "Metrics" } } } },
    "/metrics.prom": { "get": { "summary": "Prometheus-style process/request metrics", "responses": { "200": { "description": "Prometheus metrics" } } } },
    "/api/operator/summary": { "get": { "summary": "Dashboard summary", "responses": { "200": { "description": "Summary" } } } },
    "/api/system-truth": { "get": { "summary": "Source-labelled system truth", "responses": { "200": { "description": "System truth" } } } },
    "/api/competition": { "get": { "summary": "Cost-adjusted competition snapshot", "responses": { "200": { "description": "Competition snapshot" } } } },
    "/api/accounts": { "get": { "summary": "List accounts", "responses": { "200": { "description": "Accounts" } } } },
    "/api/instruments": { "get": { "summary": "List instruments", "responses": { "200": { "description": "Instruments" } } } },
    "/api/strategy-templates": { "get": { "summary": "List strategy templates", "responses": { "200": { "description": "Templates" } } } },
    "/api/strategies": { "get": { "summary": "List strategies", "responses": { "200": { "description": "Strategies" } } }, "post": { "summary": "Create free-form strategy", "responses": { "201": { "description": "Created" }, "400": { "description": "Invalid" } } } },
    "/api/strategies/from-template": { "post": { "summary": "Create strategy from template", "responses": { "201": { "description": "Created" }, "400": { "description": "Invalid" } } } },
    "/api/strategies/{id}/clone": { "post": { "summary": "Clone strategy version", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "201": { "description": "Created" }, "404": { "description": "Not found" } } } },
    "/api/strategies/{id}/status": { "post": { "summary": "Update strategy lifecycle status", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Updated" }, "404": { "description": "Not found" } } } },
    "/api/backtests": { "get": { "summary": "List backtests", "responses": { "200": { "description": "Backtests" } } }, "post": { "summary": "Legacy deterministic backtest", "responses": { "201": { "description": "Created" } } } },
    "/api/backtests/run": { "post": { "summary": "Run deterministic P1 backtest", "responses": { "201": { "description": "Completed" }, "404": { "description": "Strategy not found" } } } },
    "/api/backtests/{id}/report": { "get": { "summary": "Get backtest report", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Report" }, "404": { "description": "Not found" } } } },
    "/api/approvals": { "get": { "summary": "List approvals", "responses": { "200": { "description": "Approvals" } } }, "post": { "summary": "Legacy approval request", "responses": { "201": { "description": "Created" } } } },
    "/api/approvals/request": { "post": { "summary": "Request approval", "responses": { "201": { "description": "Requested" }, "400": { "description": "Blocked" } } } },
    "/api/approvals/{id}/decision": { "post": { "summary": "Approve or reject approval request", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Decision saved" }, "404": { "description": "Not found" } } } },
    "/api/opportunity-dashboard": { "get": { "summary": "Aggregated opportunity dashboard state", "responses": { "200": { "description": "Dashboard state" } } } },
    "/api/opportunities": { "get": { "summary": "List review opportunities", "responses": { "200": { "description": "Opportunities" } } }, "post": { "summary": "Create review opportunity", "responses": { "201": { "description": "Created" }, "400": { "description": "Invalid opportunity input" } } } },
    "/api/opportunities/generate-from-connectors": { "post": { "summary": "Generate review opportunities from connector snapshots", "responses": { "201": { "description": "Opportunities generated" }, "400": { "description": "Generation failed" } } } },
    "/api/opportunities/{id}": { "get": { "summary": "Get opportunity detail", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Opportunity detail" }, "404": { "description": "Opportunity not found" } } } },
    "/api/opportunities/{id}/approve": { "post": { "summary": "Approve guarded opportunity", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Approved" }, "409": { "description": "Economic gate blocked approval" }, "404": { "description": "Opportunity not found" } } } },
    "/api/opportunities/{id}/reject": { "post": { "summary": "Reject opportunity", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Rejected" }, "404": { "description": "Opportunity not found" } } } },
    "/api/opportunities/{id}/defer": { "post": { "summary": "Defer opportunity", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Deferred" }, "404": { "description": "Opportunity not found" } } } },
    "/api/opportunities/{id}/request-research": { "post": { "summary": "Request bounded-cost follow-up research", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Research requested" }, "409": { "description": "Economic or budget gate blocked request" }, "404": { "description": "Opportunity not found" } } } },
    "/api/risk-breakdowns": { "get": { "summary": "List risk breakdowns", "responses": { "200": { "description": "Risk breakdowns" } } } },
    "/api/agents/jobs": { "get": { "summary": "List research jobs", "responses": { "200": { "description": "Research jobs" } } }, "post": { "summary": "Create research job", "responses": { "201": { "description": "Created" }, "400": { "description": "Invalid or over-budget job" } } } },
    "/api/agents/budgets": { "get": { "summary": "List agent budgets", "responses": { "200": { "description": "Agent budgets" } } } },
    "/api/agents/budget-approvals": { "get": { "summary": "List explicit research budget approvals", "responses": { "200": { "description": "Budget approvals" } } }, "post": { "summary": "Request research budget approval", "responses": { "201": { "description": "Requested" }, "400": { "description": "Invalid request" } } } },
    "/api/agents/budget-approvals/{id}/decision": { "post": { "summary": "Approve or reject research budget approval", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Decision saved" }, "400": { "description": "Invalid decision" }, "404": { "description": "Budget approval not found" } } } },
    "/api/agents/costs": { "get": { "summary": "List agent cost ledger and summary", "responses": { "200": { "description": "Agent costs" } } } },
    "/api/market-data/snapshots": { "get": { "summary": "List normalized market data snapshots", "responses": { "200": { "description": "Market snapshots" } } } },
    "/api/connectors/market-data/ingest": { "post": { "summary": "Ingest normalized market snapshots", "responses": { "200": { "description": "Snapshots ingested" }, "400": { "description": "Connector ingest failed" } } } },
    "/api/polymarket/opportunities": { "get": { "summary": "List prediction-market opportunities", "responses": { "200": { "description": "Prediction market opportunities" } } } },
    "/api/paper-executions": { "get": { "summary": "List paper executions", "responses": { "200": { "description": "Executions" } } }, "post": { "summary": "Start paper execution", "responses": { "201": { "description": "Started" }, "400": { "description": "Blocked" } } } },
    "/api/paper-executions/{id}/stop": { "post": { "summary": "Stop paper execution", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Stopped" }, "404": { "description": "Not found" } } } },
    "/api/paper-executions/{id}/signal": { "post": { "summary": "Paper-only signal preview/fill/reconciliation", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Paper fill completed" }, "400": { "description": "Paper fill blocked" }, "404": { "description": "Paper execution not found" } } } },
    "/api/kill-switch": { "post": { "summary": "Toggle global kill switch", "responses": { "200": { "description": "Updated" } } } },
    "/api/kill-switch/stop-paper": { "post": { "summary": "Stop all paper executions", "responses": { "200": { "description": "Stopped" } } } },
    "/api/positions": { "get": { "summary": "List positions", "responses": { "200": { "description": "Positions" } } } },
    "/api/audit": { "get": { "summary": "List audit events", "responses": { "200": { "description": "Audit events" } } } },
    "/api/audit/verify": { "get": { "summary": "Verify audit hash-chain integrity", "responses": { "200": { "description": "Audit chain valid" }, "409": { "description": "Audit chain invalid or incomplete" } } } },
    "/api/economics/dashboard": { "get": { "summary": "Economic decision dashboard", "responses": { "200": { "description": "Economic evidence dashboard" } } } },
    "/api/economics/model-pricing": { "get": { "summary": "List model pricing snapshots", "responses": { "200": { "description": "Pricing snapshots" } } } },
    "/api/economics/model-pricing/refresh": { "post": { "summary": "Refresh versioned model pricing", "responses": { "201": { "description": "Pricing refreshed" }, "503": { "description": "Pricing source unavailable" } } } },
    "/api/economics/intelligence/nodes": { "get": { "summary": "Discover configured local inference nodes", "responses": { "200": { "description": "At least one healthy local node" }, "503": { "description": "No healthy local node" } } } },
    "/api/economics/model-quotes": { "post": { "summary": "Create a local-routed or explicitly enabled remote model quote", "responses": { "201": { "description": "Quote created" }, "409": { "description": "Remote execution disabled" }, "503": { "description": "No healthy local route" } } } },
    "/api/economics/intelligence/execute": { "post": { "summary": "Execute approved intelligence outside the database transaction", "responses": { "200": { "description": "Usage reconciled" }, "409": { "description": "Decision or provider policy blocked execution" }, "503": { "description": "Provider unavailable" } } } },
    "/api/economics/model-usage/reconcile": { "post": { "summary": "Reconcile actual model usage and cost", "responses": { "200": { "description": "Usage reconciled" }, "409": { "description": "Conflicting reconciliation" } } } },
    "/api/economics/maintenance/run": { "post": { "summary": "Run one guarded economic maintenance cycle", "responses": { "200": { "description": "Maintenance completed" } } } },
    "/api/economics/forecasts": { "get": { "summary": "List forecasts", "responses": { "200": { "description": "Forecasts" } } }, "post": { "summary": "Create probabilistic forecast", "responses": { "201": { "description": "Forecast created" }, "400": { "description": "Insufficient or stale observations" } } } },
    "/api/economics/forecasts/{id}/outcome": { "post": { "summary": "Record forecast outcome", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "201": { "description": "Outcome recorded" }, "404": { "description": "Forecast not found" } } } },
    "/api/economics/execution-costs": { "get": { "summary": "List execution-cost snapshots", "responses": { "200": { "description": "Execution costs" } } }, "post": { "summary": "Create execution-cost snapshot", "responses": { "201": { "description": "Snapshot created" } } } },
    "/api/economics/coinbase/refresh": { "post": { "summary": "Refresh Coinbase quote, preview, and fee evidence", "responses": { "201": { "description": "Execution-cost snapshot created" }, "400": { "description": "Preview unavailable" } } } },
    "/api/economics/decisions/evaluate": { "post": { "summary": "Evaluate value of information and net executable edge", "responses": { "201": { "description": "Decision recorded" } } } },
    "/api/economics/attribution": { "get": { "summary": "List attribution records and pending evidence", "responses": { "200": { "description": "Attribution state" } } }, "post": { "summary": "Record counterfactual attribution", "responses": { "201": { "description": "Attribution recorded" } } } },
    "/api/economics/calibration": { "get": { "summary": "Forecast calibration summary", "responses": { "200": { "description": "Calibration" } } } },
    "/api/execution/live/{path}": { "post": { "summary": "Live execution blocked", "responses": { "403": { "description": "live_execution_disabled" } } } }
  }
}
